<MudNavMenu Style="border-bottom:1px solid gray;" Bordered="true" Rounded="true">
    <MudGrid Justify="Justify.SpaceBetween" Class="px-20 py-5">
        <MudItem xs="12" sm="3" md="3" lg="3" xl="3" Class="d-flex justify-start">
            <MudText Class="py-1" Inline Color="Color.Info" Typo="Typo.h5"><b>Hesam Katouli</b></MudText>
        </MudItem>
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudItem xs="12" sm="6" md="6" lg="6" xl="6" Class="d-flex justify-center">
                <MudTooltip Text="Home" Color="Color.Dark" Arrow>
                    <ChildContent>
                        <MudIconButton ButtonType="ButtonType.Reset"
                                       Icon="@Icons.Material.Outlined.Home"
                                       Color="Color.Info" />
                    </ChildContent>
                </MudTooltip>
                <MudTooltip Text="Project" Color="Color.Dark" Arrow>
                    <ChildContent>
                        <MudIconButton ButtonType="ButtonType.Reset"
                                       Icon="@Icons.Material.Outlined.Folder"
                                       Color="Color.Info" />
                    </ChildContent>
                </MudTooltip>
                <MudTooltip Text="Tools" Color="Color.Dark" Arrow>
                    <ChildContent>
                        <MudIconButton ButtonType="ButtonType.Reset"
                                       Icon="@Icons.Material.Outlined.Build"
                                       Color="Color.Info" />
                    </ChildContent>
                </MudTooltip>
                <MudTooltip Text="Contact" Color="Color.Dark" Arrow>
                    <ChildContent>
                        <MudIconButton ButtonType="ButtonType.Reset"
                                       Icon="@Icons.Material.Outlined.Phone"
                                       Color="Color.Info" />
                    </ChildContent>
                </MudTooltip>
            </MudItem>
        </MudHidden>

        <MudItem xs="12" sm="3" md="3" lg="3" xl="3" Class="d-flex justify-end">
            <MudButton Class="py-1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" ButtonType="ButtonType.Button">Start Project</MudButton>
        </MudItem>
    </MudGrid>
</MudNavMenu>